    {
      "id": "yilong-quant",
      "name": "yilong-quant",
      "display_name": "一龙量化交易",
      "description": "面向全球加密资产交易者的量化技术测试子项目；当前提供 paper 模拟委托、模拟参与份额账本和可复现研究回测。",
      "repo_url": "git@github.com:ElonQian1/yilong-quant.git",
      "branch": "main",
      "landing": {
        "schema_version": 1,
        "title": "一龙量化交易",
        "tagline": "面向全球加密资产交易者的量化交易技术测试平台",
        "summary": "当前提供主项目 ESK Paper 余额的签名只读显示、paper 模拟交易和模拟参与份额账本；6% 是非保证目标，不接收或移动真实用户资金，也不连接实盘。",
        "highlights": [
          "版本化研究行情与单机可复现回测已建立，结果携带来源、策略、费用、滑点和确定性摘要",
          "Rust 风控、订单、交易所端口和追加式参与账本按领域分层",
          "主项目 ESK 余额通过最长五分钟签名投影只读显示，总额、可用额、卖回占用和源修订可核对",
          "历史模拟 NET 配额可由运营审核追加为内部份额；它是旧测试单位，不会自动改名或折算为 ESK",
          "短期签名授权只允许用户查看和退出自己的模拟仓位，支持密钥级撤销及单个授权跨重启撤销",
          "主项目是 ESK 资产真源；量化仓库不铸造或修改 ESK、不共享密钥或资金账本"
        ],
        "target_users": [
          "希望参与量化交易技术测试的全球加密资产玩家",
          "策略、风控、交易系统和产品会计开发者"
        ],
        "downloads": {
          "web": {
            "label": "Web 技术测试面板",
            "status": "planned",
            "note": "本地版本已建立，公开测试地址尚未部署"
          },
          "windows": {
            "label": "Windows 桌面端",
            "status": "planned",
            "note": "后续复用一龙 Tauri 2 桌面技术栈"
