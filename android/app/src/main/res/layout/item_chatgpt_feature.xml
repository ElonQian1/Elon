<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatGptFeatureLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/elon_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/chatGptFeatureKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/chatGptFeatureSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/chatgpt_features_current"
        android:textColor="@color/elon_status_project"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/profile_icon_chevron" />
</LinearLayout>
