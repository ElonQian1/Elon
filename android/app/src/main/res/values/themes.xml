<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ElonApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#07C160</item>
        <item name="colorPrimaryVariant">#05A653</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#EDEDED</item>
        <item name="android:navigationBarColor">#F7F7F7</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="MainTabText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="QuickActionButton">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_quick_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="StageLineText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProjectActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>
