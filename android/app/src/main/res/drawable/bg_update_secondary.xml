<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/elon_surface_soft"
                android:endColor="@color/elon_surface_card" />
            <stroke android:width="1dp" android:color="@color/elon_border_primary" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/elon_surface_header"
                android:endColor="@color/elon_surface_card" />
            <stroke android:width="1dp" android:color="@color/elon_border_subtle" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
