<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_provider_accounts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="在一个应用里管理官方 CLI 登录。账号凭据始终由所选 Win 节点上的 Codex、Gemini、Claude 或 Copilot 官方存储保存。"
        android:textColor="@color/elon_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_orbital_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Spinner
            android:id="@+id/aiProviderNodeSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:popupBackground="@color/elon_surface_header"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/aiProviderRefresh"
            android:layout_width="88dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="刷新节点"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/aiProviderProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aiProviderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="正在读取节点…"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/aiProviderDiagnostics"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/elon_button_secondary_bg"
        android:text="读取脱敏恢复诊断"
        android:textColor="@color/elon_button_secondary_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/aiProviderChatGptWebLab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/elon_button_primary_bg"
        android:drawableStart="@android:drawable/ic_menu_view"
        android:drawableTint="@color/elon_button_primary_text"
        android:text="@string/chatgpt_web_lab_entry"
        android:textColor="@color/elon_button_primary_text"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/aiProviderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />
    </ScrollView>

</LinearLayout>
