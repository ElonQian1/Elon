# 强制 bash 脚本和 git hook 保持 LF 行尾（Windows clone 时不被 autocrlf 转 CRLF）
# CRLF 会导致 bash 在 Linux/macOS 报 "syntax error near unexpected token `$'do\r''"
*.sh         text eol=lf
*.service    text eol=lf
.githooks/*  text eol=lf
*.rs         text eol=lf
*.tsv        text eol=lf
contracts/quant/*.json text eol=lf
# Raw Sui verification receipts are hashed byte-for-byte and must be cross-platform stable.
contracts/sui/**/evidence/*.txt text eol=lf
# Native ESK contract copies must remain byte-identical across repositories.
docs/contracts/esk-android-snapshot-v1.md text eol=lf
docs/contracts/esk-platform-android-snapshot-v1.md text eol=lf
# Formal progress contract and synthetic vectors are shared byte-for-byte.
android/app/src/main/kotlin/com/elon/eskcontract/EskPlatformProgressContract.kt text eol=lf
android/app/src/main/kotlin/com/elon/eskcontract/EskPlatformProgressRows.kt text eol=lf
android/app/src/test/kotlin/com/elon/eskcontract/EskPlatformProgressContractTest.kt text eol=lf
android/app/src/test/kotlin/com/elon/eskcontract/EskPlatformProgressRowsTest.kt text eol=lf
android/app/src/test/kotlin/com/elon/eskcontract/EskPlatformProgressFixtures.kt text eol=lf
# Semantic verification hashes must match the committed bytes on every host.
docs/design/mobile-design-system-v2.md text eol=lf
docs/requirements/mobile-design-v2-adoption.md text eol=lf
docs/requirements/group-chat-readability-20260929.md text eol=lf
docs/ui/semantic-parity/*.json text eol=lf
