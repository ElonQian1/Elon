<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/elon_button_secondary_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/elon_border_subtle" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/elon_nav_active_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/elon_border_subtle" />
        </shape>
    </item>
</selector>
