<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F7F7F7"
        android:elevation="1dp"
        app:title="一龙开发助手"
        app:titleTextColor="#111111" />

    <LinearLayout
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="连接中..."
            android:textColor="#07C160"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/currentStageText"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_stage_badge"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="待提交需求"
            android:textColor="#1F7A3D"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/chatPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#FFFFFF"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/quickPlanButton"
                        style="@style/QuickActionButton"
                        android:text="需求规划" />

                    <TextView
                        android:id="@+id/quickContinueButton"
                        style="@style/QuickActionButton"
                        android:text="继续开发" />

                    <TextView
                        android:id="@+id/quickBuildButton"
                        style="@style/QuickActionButton"
                        android:text="打包 APK" />

                    <TextView
                        android:id="@+id/quickHistoryButton"
                        style="@style/QuickActionButton"
                        android:text="查看记录" />

                    <TextView
                        android:id="@+id/quickSettingsButton"
                        style="@style/QuickActionButton"
                        android:text="AI 设置" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/projectBriefPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/projectStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前项目：等待你的第一个开发需求"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stageHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="发一句需求，我会把分析、编码、打包和交付记录在这里。"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/progressPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/progressTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:padding="14dp"
                    android:text="开发进度：等待需求"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/stagePlanText"
                        style="@style/StageLineText"
                        android:text="1. 需求分析：等待" />

                    <TextView
                        android:id="@+id/stageCodeText"
                        style="@style/StageLineText"
                        android:text="2. 开发实现：等待" />

                    <TextView
                        android:id="@+id/stageBuildText"
                        style="@style/StageLineText"
                        android:text="3. 编译打包：等待" />

                    <TextView
                        android:id="@+id/stageDeliverText"
                        style="@style/StageLineText"
                        android:text="4. 交付下载：等待" />
                </LinearLayout>

                <TextView
                    android:id="@+id/projectHistoryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="220dp"
                    android:padding="14dp"
                    android:text="暂无进度记录"
                    android:textColor="#333333"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/projectPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/projectOverviewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="项目管理\n当前没有正在执行的开发任务。"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/projectContinueButton"
                        style="@style/ProjectActionButton"
                        android:text="继续开发" />

                    <TextView
                        android:id="@+id/projectBuildButton"
                        style="@style/ProjectActionButton"
                        android:text="生成 APK" />

                    <TextView
                        android:id="@+id/projectRecordButton"
                        style="@style/ProjectActionButton"
                        android:text="进度记录" />

                    <TextView
                        android:id="@+id/projectSettingsButton"
                        style="@style/ProjectActionButton"
                        android:text="模型设置" />
                </GridLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/profilePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/userInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="我的开发工作台"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/profileSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="AI 代理设置"
                    android:textColor="#111111"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F7F7"
        android:elevation="4dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/inputEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="描述你想开发的 App 功能"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="42dp"
            android:minLines="1"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="#111111"
            android:textColorHint="#9A9A9A"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sendButton"
            android:layout_width="64dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button"
            android:gravity="center"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pageTabs"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tabChat"
            style="@style/MainTabText"
            android:text="会话" />

        <TextView
            android:id="@+id/tabProgress"
            style="@style/MainTabText"
            android:text="进度" />

        <TextView
            android:id="@+id/tabProject"
            style="@style/MainTabText"
            android:text="项目" />

        <TextView
            android:id="@+id/tabProfile"
            style="@style/MainTabText"
            android:text="我的" />
    </LinearLayout>
</LinearLayout>
