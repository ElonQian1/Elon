# 一龙 PC 节点配置模板
# 使用方法：把本文件复制为同目录下的  node-agent.env  并填写下面的值。
# 启动器（启动一龙节点.cmd）会自动读取 node-agent.env。

# ── 必填 ──────────────────────────────────────────────
# 本节点唯一 ID（自己起名，全局唯一，例如 my-pc-1）
NODE_AGENT_ID=my-pc-1
# 认证密钥（64 字符随机 hex，自行生成一次后固定）
NODE_AGENT_SECRET=
# 你的 elon 用户 ID
NODE_OWNER_USER_ID=

# ── 注册本地项目需要 ──────────────────────────────────
# 你的 elon 登录 token（在 APK 登录后获取；不填则无法在管理页注册本地项目）
NODE_USER_TOKEN=

# ── 可选（一般保持默认即可）──────────────────────────
# 云端 WebSocket 地址
NODE_CLOUD_URL=ws://43.139.149.158:8080/agent/ws
# 本地 Ollama 地址
NODE_OLLAMA_URL=http://localhost:11434
# 管理页端口（默认 7799）
# NODE_ADMIN_PORT=7799
# elon-node-agent.exe 的完整路径（默认同目录）
# NODE_AGENT_EXE=D:\elon\elon-node-agent.exe
