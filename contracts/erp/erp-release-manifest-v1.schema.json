{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yilong.ai/contracts/erp/erp-release-manifest-v1.schema.json",
  "title": "Yilong ERP Release Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "blueprint_key", "version", "source_git_commit", "modules", "capabilities", "extension_points", "migrations", "compatibility", "rollback"],
  "properties": {
    "schema": { "const": "yilong.erp.release.v1" },
    "blueprint_key": { "type": "string", "minLength": 3, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "previous_version": { "type": ["string", "null"] },
    "source_git_commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/versioned" }, "minItems": 1 },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "extension_points": { "type": "array", "items": { "type": "string" } },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["migration_key", "reversible"],
        "properties": {
          "migration_key": { "type": "string", "minLength": 2, "maxLength": 120 },
          "reversible": { "type": "boolean" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_instance_version"],
      "properties": {
        "minimum_instance_version": { "type": "string" },
        "required_plugins": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "instructions"],
      "properties": {
        "supported": { "type": "boolean" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  },
  "$defs": {
    "versioned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_key", "version", "required"],
      "properties": {
        "module_key": { "type": "string", "minLength": 2, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "required": { "type": "boolean" }
      }
    }
  }
}
