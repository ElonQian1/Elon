{
  "name": "elon-pc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:message-flow": "node ../scripts/test-pc-frontend-message-flow.js && node ../scripts/test-pc-frontend-task-result-tone.js && node ../scripts/test-pc-frontend-task-timeline-display.js && node ../scripts/test-pc-frontend-task-progress-preview.js && node ../scripts/test-pc-frontend-task-replay.js && node ../scripts/test-pc-frontend-task-recovery-snapshot.js",
    "test:workspace-access": "node ../scripts/test-pc-frontend-workspace-access.js",
    "test:local-tasks": "node scripts/test-local-tasks.cjs",
    "test:runtime-draft": "node scripts/test-runtime-draft-model.cjs",
    "test:ui-tuner-workspace": "node scripts/test-ui-tuner-workspace.cjs",
    "test:pwa-design": "node scripts/test-pwa-design.cjs",
    "test:project-docs": "node scripts/test-project-document-sections.cjs",
    "test:project-home": "node ../scripts/test-pc-project-home.js && node ../scripts/test-pc-project-context-sidebar.js",
    "test:message-actions": "node scripts/test-message-actions-hover.cjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
