<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_orbital_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/providerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/elon_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/providerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/elon_status_info"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/providerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autoLink="web"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/elon_text_secondary"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <Button
        android:id="@+id/providerOfficialLoginAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/elon_button_secondary_bg"
        android:textColor="@color/elon_button_secondary_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/providerPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/elon_button_primary_bg"
        android:textColor="@color/elon_button_primary_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
