{
  "schema": "elon.cargo_sources.v1",
  "probe_timeout_seconds": 8,
  "fetch_timeout_seconds": 45,
  "total_budget_seconds": 150,
  "health_success_ttl_seconds": 600,
  "circuit_failure_threshold": 2,
  "circuit_open_seconds": 300,
  "maximum_redirects": 2,
  "sources": [
    {
      "id": "crates-io-official",
      "index": "sparse+https://index.crates.io/",
      "evidence": "https://doc.rust-lang.org/cargo/reference/registry-index.html#sparse-protocol",
      "operator_domains": ["rust-lang.org", "crates.io"]
    },
    {
      "id": "rsproxy-official",
      "index": "sparse+https://rsproxy.cn/index/",
      "evidence": "https://rsproxy.cn/",
      "operator_domains": ["rsproxy.cn", "bytedance.com"]
    },
    {
      "id": "ustc-official",
      "index": "sparse+https://mirrors.ustc.edu.cn/crates.io-index/",
      "evidence": "https://mirrors.ustc.edu.cn/help/crates.io-index.html",
      "operator_domains": ["ustc.edu.cn"]
    }
  ]
}
