#!/usr/bin/env bash
set -e
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
cd "$REPO_ROOT"

# Linked-worktree hooks inherit common-repository variables; anchor to this hook.
git_local_env_vars="$(git rev-parse --local-env-vars)"
if [ -n "$git_local_env_vars" ]; then unset $git_local_env_vars; fi
while read -r _local_ref _local_sha _remote_ref _remote_sha; do :; done

UNTRACKED_RS=$(git ls-files --others --exclude-standard | grep -E '\.rs$' || true)
if [ -n "$UNTRACKED_RS" ]; then
  echo -e "${RED}pre-push rejected: untracked Rust source files:${NC}" >&2
  echo "$UNTRACKED_RS" | sed 's/^/   /' >&2
  exit 1
fi

PS_CMD=""
if command -v powershell >/dev/null 2>&1; then PS_CMD="powershell"; elif command -v pwsh >/dev/null 2>&1; then PS_CMD="pwsh"; fi
if [ -z "$PS_CMD" ]; then
  echo -e "${RED}pre-push rejected: powershell/pwsh unavailable${NC}" >&2
  exit 1
fi

git diff --check
git diff --cached --check
bash scripts/format-rust.sh
"$PS_CMD" -NoProfile -ExecutionPolicy Bypass -File scripts/check-source-size.ps1

# Rust receipt validation is opt-in because it can run cargo check. Keep the
# existing fail-closed gate available for callers that explicitly request it.
if [ "${ELON_ENABLE_RUST_PUSH_RECEIPT:-}" = "1" ]; then
  echo -e "${YELLOW}RUST_PUSH_RECEIPT_GATE=enabled${NC}"
  if [ -f "server/Cargo.toml" ]; then
    echo -e "${YELLOW}pre-push: checking managed Rust receipt...${NC}"
    if ! "$PS_CMD" -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-push.ps1 -SkipCheapGates 2>&1; then
      echo -e "${RED}pre-push rejected: Rust receipt preparation failed${NC}" >&2
      exit 1
    fi
  fi
else
  echo -e "${YELLOW}RUST_PUSH_RECEIPT_GATE=disabled (set ELON_ENABLE_RUST_PUSH_RECEIPT=1 to enable)${NC}"
fi

echo -e "${GREEN}pre-push gates passed${NC}"
exit 0
