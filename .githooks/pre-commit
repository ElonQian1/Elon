#!/usr/bin/env bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
cd "$REPO_ROOT"

git_local_env_vars="$(git rev-parse --local-env-vars)"
if [ -n "$git_local_env_vars" ]; then unset $git_local_env_vars; fi

PS_CMD=""
if command -v powershell >/dev/null 2>&1; then
  PS_CMD="powershell"
elif command -v pwsh >/dev/null 2>&1; then
  PS_CMD="pwsh"
fi
if [ -z "$PS_CMD" ]; then
  echo -e "${RED}pre-commit rejected: powershell/pwsh unavailable${NC}" >&2
  exit 1
fi

git diff --cached --check
"$PS_CMD" -NoProfile -ExecutionPolicy Bypass \
  -File scripts/check-document-modularity.ps1 \
  -BaseRef HEAD \
  -Staged \
  -AutomationHandoff
"$PS_CMD" -NoProfile -ExecutionPolicy Bypass \
  -File scripts/check-ai-project-entrypoints.ps1

echo -e "${GREEN}pre-commit document modularity gate passed or handed off to post-commit automation${NC}"
