<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 说明文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:text="当前测试阶段已锁定 Codex CLI。\n• 聊天、意图分析和代码协作统一走 Codex CLI\n• 暂不切换到其他 AI 代理或自定义 API 模型\n• 恢复多模型前会同步更新服务端和 APK 设置"
            android:textColor="#1565C0"
            android:textSize="13sp" />

        <!-- ── 选择模式 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="AI 模型模式"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/modeDefault"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="🌐  使用服务器默认模型（推荐）"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/modePreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="📋  选择预设模型"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/modeCustom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="🔧  自定义 API Key 和模型"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- ── 预设代理选择 ── -->
        <LinearLayout
            android:id="@+id/presetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="选择模型"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/agentSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF"
                android:padding="8dp" />
        </LinearLayout>

        <!-- ── 自定义配置 ── -->
        <LinearLayout
            android:id="@+id/customLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API 地址（Base URL）"
                android:textColor="#555555"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:hint="https://api.deepseek.com/v1"
                android:inputType="textUri"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API 密钥"
                android:textColor="#555555"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:hint="sk-..."
                android:inputType="textPassword"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="模型名称"
                android:textColor="#555555"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:hint="deepseek-chat"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── 昵称（通用） ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="我的昵称（可选，仅管理员可见）"
            android:textColor="#555555"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/nicknameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF"
            android:hint="输入昵称..."
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- ── 保存按钮 ── -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#2196F3"
            android:text="保存配置"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- ── 检查更新 ── -->
        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#4CAF50"
            android:text="检查更新"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- ── 用户 ID 展示 ── -->
        <TextView
            android:id="@+id/userIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
