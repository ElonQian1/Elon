<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/elon_surface_soft" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/elon_border_subtle" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/elon_titanium_end"
                android:centerColor="@color/elon_titanium_mid"
                android:endColor="@color/elon_titanium_end" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/elon_metal_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/elon_titanium"
                android:centerColor="@color/elon_titanium_mid"
                android:endColor="@color/elon_titanium_end" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/elon_metal_highlight" />
        </shape>
    </item>
</selector>
