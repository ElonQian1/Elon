#!/usr/bin/env bash
set -e

YELLOW='\033[1;33m'
NC='\033[0m'
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
cd "$REPO_ROOT"

git_local_env_vars="$(git rev-parse --local-env-vars)"
if [ -n "$git_local_env_vars" ]; then unset $git_local_env_vars; fi

PS_CMD=""
if command -v powershell >/dev/null 2>&1; then
  PS_CMD="powershell"
elif command -v pwsh >/dev/null 2>&1; then
  PS_CMD="pwsh"
fi
if [ -z "$PS_CMD" ]; then
  echo -e "${YELLOW}post-commit: powershell/pwsh unavailable; document organization signal remains queued${NC}" >&2
  exit 0
fi

if ! "$PS_CMD" -NoProfile -ExecutionPolicy Bypass \
  -File scripts/dispatch-document-organization.ps1; then
  echo -e "${YELLOW}post-commit: automatic document organization dispatch failed; signal remains queued${NC}" >&2
fi

exit 0
