{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-ai-web",
  "description": "ChatGPT 官方网页子窗口只能上报本机可见语义，不能调用主窗口会话控制或读取凭证。",
  "windows": ["local-ai-chatgpt-*"],
  "remote": {
    "urls": [
      "https://chatgpt.com/*",
      "https://*.chatgpt.com/*",
      "https://openai.com/*",
      "https://*.openai.com/*"
    ]
  },
  "permissions": ["local-ai-web-adapter-event"]
}
