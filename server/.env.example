# 服务端环境变量配置
# 复制此文件为 .env 并填入真实值（.env 不提交到 git）

# ===================
# AI 代理配置（至少配置一个）
# ===================

# 默认用户消息后端：
# - local_cli：优先调用服务器本地 AI CLI（推荐，可接 Codex/Copilot 等）
# - api：使用下面保留的 OpenAI 兼容 API 代理
AI_BACKEND=local_cli

# 本地 AI CLI 总开关。服务器需先完成对应 CLI 登录/鉴权。
AI_CLI_ENABLED=true
AI_CLI_DEFAULT=codex_cli
# 当前阶段全流程锁定 Codex CLI，默认不回退 API 代理。
# 只有未来明确要恢复 API 旁路时，才显式设置 AI_ALLOW_API_FALLBACK=true。
AI_ALLOW_API_FALLBACK=false
AI_CODEX_CLI_ONLY=true
# 项目聊天轻量分流默认关闭：项目消息默认进入 Codex/PC 节点项目通道，
# 由 Codex 自己判断只是回答问题还是需要读写文件、运行命令、提交发布。
# 只有明确想恢复“普通聊天快速短答/轻量 prompt”时才改为 true。
AI_PROJECT_LIGHTWEIGHT_CHAT_ENABLED=false

# 只读项目上下文编译器（灰度功能，默认关闭，不影响现有 Codex 主链路）。
# - shadow：生成 repo/context 预检并写 trace/log，但不注入 Codex prompt。
# - inject：把短上下文包合并到项目预检摘要里，Codex 仍需读取真实文件后再修改。
ELON_CONTEXT_COMPILER_ENABLED=false
ELON_CONTEXT_COMPILER_MODE=shadow
ELON_CONTEXT_COMPILER_AGENT=hunyuan
ELON_CONTEXT_COMPILER_LLM_BRIEF=true
ELON_CONTEXT_COMPILER_RUST_ANALYSIS=true
ELON_CONTEXT_COMPILER_RUST_ANALYZER=true
ELON_CONTEXT_COMPILER_MAX_FILES=8
ELON_CONTEXT_COMPILER_MAX_RUST_FILES=400
ELON_CONTEXT_COMPILER_MAX_SYMBOLS=80
ELON_CONTEXT_COMPILER_MAX_RELATIONSHIPS=120
ELON_CONTEXT_COMPILER_RA_FILES=6
ELON_CONTEXT_COMPILER_MAX_CHARS=24000
ELON_CONTEXT_COMPILER_SAVE_PACK=true
ELON_CONTEXT_COMPILER_ARTIFACT_MAX_BYTES=200000
ELON_CONTEXT_COMPILER_RUST_PROBE=true

# Codex CLI 配置；如果配置 CODEX_CLI_MODELS，APK 会出现多个可切换模型。
CODEX_CLI_ENABLED=true
CODEX_CLI_BIN=codex
CODEX_CLI_ARGS=exec --sandbox workspace-write --skip-git-repo-check
CODEX_CLI_MODEL_ARG=-m
# CODEX_CLI_MODELS=gpt-5,gpt-5.1-codex
CODEX_CLI_PROMPT_MODE=arg
CODEX_CLI_TIMEOUT_SECS=1800

# Copilot CLI 预留配置；按服务器实际安装的 copilot 命令参数调整。
# COPILOT_CLI_ENABLED=false
# COPILOT_CLI_BIN=copilot
# COPILOT_CLI_ARGS=
# COPILOT_CLI_MODEL_ARG=--model
# COPILOT_CLI_MODELS=claude-sonnet-4.5,gpt-5
# COPILOT_CLI_PROMPT_MODE=arg
# COPILOT_CLI_TIMEOUT_SECS=1800

# 更通用的 CLI 选项 JSON，可用于接入任意 AI CLI。
# AI_CLI_OPTIONS_JSON=[{"id":"mycli:gpt-5","label":"My CLI / GPT-5","provider":"mycli","model":"gpt-5","bin":"mycli","args":["--model","gpt-5","run"],"prompt_mode":"arg","timeout_secs":1800}]

# OpenAI
# AGENT_OPENAI_KEY=sk-你的OpenAI密钥
# AGENT_OPENAI_BASE=https://api.openai.com/v1
# AGENT_OPENAI_MODEL=gpt-4o

# DeepSeek（国内首选，价格便宜）
AGENT_DEEPSEEK_KEY=sk-你的DeepSeek密钥
# AGENT_DEEPSEEK_BASE=https://api.deepseek.com/v1
# AGENT_DEEPSEEK_MODEL=deepseek-chat

# Claude
# AGENT_CLAUDE_KEY=sk-ant-你的Claude密钥
# AGENT_CLAUDE_BASE=https://api.anthropic.com/v1
# AGENT_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 腾讯混元（兼容 OpenAI 接口）
# AGENT_HUNYUAN_KEY=你的混元API密钥
# AGENT_HUNYUAN_BASE=https://api.hunyuan.cloud.tencent.com/v1
# AGENT_HUNYUAN_MODEL=hunyuan-turbo

# TokenHub 聊天模型（兼容 OpenAI Chat Completions）
# AGENT_TOKENHUB_KEY=你的TokenHub聊天API密钥
# AGENT_TOKENHUB_BASE=https://tokenhub.tencentmaas.com/v1
# AGENT_TOKENHUB_MODEL=hunyuan-2.0-instruct-20251111

# TokenHub 文生图（混元生图 3.0）
# IMAGE_API_KEY=你的TokenHub API Key
# IMAGE_API_BASE=https://tokenhub.tencentmaas.com/v1/api/image
# IMAGE_MODEL=hy-image-v3.0
# IMAGE_POLL_INTERVAL_SECS=5
# IMAGE_MAX_ATTEMPTS=24

# ===================
# 女声情绪 TTS（可选）
# ===================

# 独立 TTS Worker 地址；未设置时 /api/voice/tts 返回 503，APK 自动回退 Android 系统 TTS。
# ELON_TTS_WORKER_URL=http://127.0.0.1:5010
# ELON_TTS_PROVIDER=auto
# ELON_TTS_WORKER_TOKEN=
# ELON_TTS_TIMEOUT_SECS=120
# ELON_TTS_CACHE_ENABLED=true
# ELON_TTS_LLM_REWRITE_ENABLED=false

# 自定义兼容 OpenAI 接口
# AGENT_CUSTOM_KEY=密钥
# AGENT_CUSTOM_BASE=https://自定义接口地址/v1
# AGENT_CUSTOM_MODEL=模型名

# 默认使用的 AI 代理（不填则自动用第一个配置的）
# DEFAULT_AGENT=deepseek

# ===================
# 服务配置
# ===================

# 用户工作区根目录
# 每个用户有独立子目录：{WORKSPACE_ROOT}/{user_id}/
WORKSPACE_ROOT=/home/ubuntu/workspaces

# 服务器对外公开 URL（用于生成 APK 下载链接）
PUBLIC_URL=http://182.254.168.75:8080

# 服务监听地址
LISTEN_ADDR=0.0.0.0:8080

# 日志级别
RUST_LOG=info,elon_server=debug

# ===================
# 管理后台配置
# ===================

# 管理后台访问令牌（访问 /admin 需要输入此令牌）
# 生产环境务必修改为随机强密码！
ADMIN_TOKEN=elon-admin

# 用户敏感凭据加密密钥。生产环境使用 32 字节随机值，Codex Pro 保险箱优先使用专用密钥；
# 未设置 CODEX_VAULT_MASTER_KEY 时会回退 USER_API_KEY_SECRET / SECRET_KEY。
# CODEX_VAULT_MASTER_KEY=openssl-rand-base64-32-bytes
# USER_API_KEY_SECRET=openssl-rand-base64-32-bytes
# SECRET_KEY=openssl-rand-base64-32-bytes

# AI 代理配置持久化文件（管理后台修改后自动写入，优先级高于上面的环境变量）
# CONFIG_PATH=./agents.json

# AI API 地址（默认 OpenAI，可替换为其他兼容接口）
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 中转代理: https://你的代理地址/v1
AI_API_BASE=https://api.openai.com/v1

# 使用的模型（推荐 gpt-4o 或 deepseek-chat）
AI_MODEL=gpt-4o

# 项目代码根目录（AI 代理在此目录内读写文件）
PROJECT_ROOT=/home/ubuntu/Elon

# 服务监听地址（0.0.0.0 表示外网可访问）
LISTEN_ADDR=0.0.0.0:8080

# 日志级别
RUST_LOG=info,elon_server=debug
