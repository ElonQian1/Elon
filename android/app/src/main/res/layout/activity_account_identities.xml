<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="登录方式"
            android:textColor="@color/elon_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="把 Google 绑定到当前一龙账号，以后可选择任一登录方式进入同一个账号。"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_orbital_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前一龙账号"
                android:textColor="@color/elon_text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/accountCurrentAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="读取中…"
                android:textColor="@color/elon_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Google 将作为这个账号的新登录方式，不会创建副本。"
                android:textColor="@color/elon_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Google 登录"
            android:textColor="@color/elon_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountGoogleBindingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="正在读取绑定状态…"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/accountIdentityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/accountBindGoogleButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="绑定 Google 到当前账号"
            android:textColor="@color/elon_button_secondary_text" />

        <TextView
            android:id="@+id/accountIdentityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/elon_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_orbital_panel"
            android:padding="14dp"
            android:text="安全提示：同邮箱不会自动合并，也不会保存 Google 密码或访问令牌。若 Google 已属于另一账号，请先在原账号解绑。"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="密码与恢复"
            android:textColor="@color/elon_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountPasswordSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="读取账号安全状态…"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/accountCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="当前密码（首次设置可留空）"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary" />

        <EditText
            android:id="@+id/accountNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="新密码"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary" />

        <EditText
            android:id="@+id/accountConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="再次输入新密码"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary" />

        <Button
            android:id="@+id/accountChangePasswordButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="设置或修改密码"
            android:textColor="@color/elon_button_secondary_text" />

        <Button
            android:id="@+id/accountRotateRecoveryCodesButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="生成新的一组恢复码"
            android:textColor="@color/elon_button_secondary_text" />

        <TextView
            android:id="@+id/accountSecurityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/elon_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="登录设备与会话"
            android:textColor="@color/elon_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/accountSessionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/accountRevokeOtherSessionsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="退出其他设备"
            android:textColor="@color/elon_button_secondary_text" />
    </LinearLayout>
</ScrollView>
