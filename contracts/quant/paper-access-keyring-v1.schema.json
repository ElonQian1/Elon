{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yilong.example/contracts/quant/paper-access-keyring-v1.schema.json",
  "title": "Yilong Quant Paper Access Keyring V1",
  "description": "Public Ed25519 verification keys pinned by the yilong-quant Paper deployment. This contract never carries signing seeds or subject secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys"],
  "properties": {
    "schema": { "const": "yilong.quant.paper_access_keyring.v1" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/trustedKey" }
    }
  },
  "$defs": {
    "trustedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "public_key_base64url", "status"],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "public_key_base64url": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Exactly 32 Ed25519 public-key bytes encoded as base64url without padding."
        },
        "status": { "enum": ["active", "retiring", "revoked"] },
        "issued_at_not_before_unix": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at_not_after_unix": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "retiring" } },
            "required": ["status"]
          },
          "then": { "required": ["issued_at_not_after_unix"] }
        }
      ]
    }
  }
}
