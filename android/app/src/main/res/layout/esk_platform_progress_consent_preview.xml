<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/esk_platform_progress_consent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESK 额度与进度授权"
            android:textColor="@color/elon_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="一龙量化 · 本次主项目账户确认"
            android:textColor="@color/elon_text_secondary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/esk_platform_progress_consent_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="尚未确认账户"
            android:textColor="@color/elon_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/esk_platform_progress_consent_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="本次仅查看一页，每页最多 20 条。"
            android:textColor="@color/elon_text_primary"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="仅向本机已验证的一龙量化原生页面提供正式 ESK 总量、卖回占用、可申请量及一页申请 ID、金额、状态和时间。每页重新确认，不连续读取。"
            android:textColor="@color/elon_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="平台登记 · 尚未上链 · 未兑付。不包含 Paper 模拟资产；可申请量不是可提现金额。本次不提交、不取消申请，也不买卖、转账或授权交易。"
            android:textColor="@color/elon_text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="不传登录凭据、账户身份、幂等键或政策正文，不绑定量化网页登录账户。摘要最多显示 60 秒，不是实时余额；返回后无法远程撤回，量化离页或到期清除。"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />
        <TextView
            android:id="@+id/esk_platform_progress_consent_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:text="请核对账户。离开此页会取消授权。"
            android:textColor="@color/elon_text_secondary"
            android:textSize="15sp" />
        <Button
            android:id="@+id/esk_platform_progress_consent_primary_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:enabled="false"
            android:text="确认并读取本页进度" />
        <Button
            android:id="@+id/esk_platform_progress_consent_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:text="取消并返回量化应用" />
    </LinearLayout>
</ScrollView>
