<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 说明文字 -->
        <TextView
            android:id="@+id/agentReadinessText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/elon_badge_info_bg"
            android:padding="12dp"
            android:text="正在加载 AI 代理和项目 RAG 状态..."
            android:textColor="@color/elon_badge_info_text"
            android:textSize="13sp" />

        <!-- ── 选择模式 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="AI 模型模式"
            android:textColor="@color/elon_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_orbital_panel"
            android:orientation="vertical"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/modeDefault"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="🌐  使用服务器默认模型（推荐）"
                android:textColor="@color/elon_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/modePreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="📋  选择预设模型"
                android:textColor="@color/elon_text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/modeCustom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                android:text="🔧  自定义 API Key 和模型"
                android:textColor="@color/elon_text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- ── 预设代理选择 ── -->
        <LinearLayout
            android:id="@+id/presetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="选择模型"
                android:textColor="@color/elon_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/agentSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_orbital_panel"
                android:padding="8dp" />
        </LinearLayout>

        <!-- ── 自定义配置 ── -->
        <LinearLayout
            android:id="@+id/customLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API 地址（Base URL）"
                android:textColor="@color/elon_text_secondary"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_orbital_panel"
                android:hint="https://api.deepseek.com/v1"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/elon_text_primary"
                android:textColorHint="@color/elon_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API 密钥"
                android:textColor="@color/elon_text_secondary"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_orbital_panel"
                android:hint="sk-..."
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/elon_text_primary"
                android:textColorHint="@color/elon_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="模型名称"
                android:textColor="@color/elon_text_secondary"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/customModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_orbital_panel"
                android:hint="deepseek-chat"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/elon_text_primary"
                android:textColorHint="@color/elon_text_tertiary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/testAgentButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/elon_button_secondary_bg"
                android:text="测试连接"
                android:textColor="@color/elon_button_secondary_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── 昵称（通用） ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="我的昵称（可选，仅管理员可见）"
            android:textColor="@color/elon_text_secondary"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/nicknameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_orbital_panel"
            android:hint="输入昵称..."
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary"
            android:textSize="14sp" />

        <!-- ── AI 回复语音 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="AI 回复语音"
            android:textColor="@color/elon_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttsVoiceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/elon_surface_subtle"
            android:padding="10dp"
            android:textColor="@color/elon_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ttsVoiceButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="切换语音"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="13sp" />

        <!-- ── 语音输入模式 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="语音输入模式"
            android:textColor="@color/elon_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="选择麦克风按钮使用哪种识别管线"
            android:textColor="@color/elon_text_secondary"
            android:textSize="11sp" />
        <RadioGroup
            android:id="@+id/voiceModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/voiceModeAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="端上识别（推荐，低延迟）"
                android:textColor="@color/elon_text_primary" />
            <RadioButton
                android:id="@+id/voiceModeCloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="云端直连（PCM 流→服务器→AI 直发）"
                android:textColor="@color/elon_text_primary" />
            <RadioButton
                android:id="@+id/voiceModeVoiceMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎤 语音消息（录音发送气泡，可播放）"
                android:textColor="@color/elon_text_primary" />
        </RadioGroup>

        <Button
            android:id="@+id/manageEngineButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="🎙 管理识别引擎（测试 / 选择 / 排除）"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="13sp" />

        <!-- ── 本地引擎回退链摘要 ── -->
        <TextView
            android:id="@+id/asrChainSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/elon_surface_subtle"
            android:padding="10dp"
            android:textColor="@color/elon_text_secondary"
            android:textSize="11sp" />

        <!-- ── 服务器 Whisper 兜底开关 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="2dp"
            android:text="本地引擎回退链"
            android:textColor="@color/elon_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_orbital_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="云端 Whisper 兜底"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="本地全部引擎失败时，上传录音到服务器转写（需联网）"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchServerFallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true"
                android:thumbTint="@color/elon_badge_info_text"
                android:trackTint="@color/elon_badge_info_bg" />
        </LinearLayout>

        <!-- ── 保存按钮 ── -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/elon_button_primary_bg"
            android:text="保存配置"
            android:textColor="@color/elon_button_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- ── Token 用量统计 ── -->
        <Button
            android:id="@+id/tokenUsageButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="📊 Token 用量统计"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/aiProviderAccountsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="AI 厂商账号 · Codex / Gemini / Claude / Copilot"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="14sp" />

        <!-- ── 检查更新 ── -->
        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/elon_button_primary_bg"
            android:text="检查更新"
            android:textColor="@color/elon_button_primary_text"
            android:textSize="14sp" />

        <!-- ── 用户 ID 展示 ── -->
        <TextView
            android:id="@+id/userIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/elon_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
