<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/messageTimelineLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="start"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="52dp"
        android:paddingBottom="6dp">

    <TextView
        android:id="@+id/messageSelectionCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_message_selection_off"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/elon_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_app_brand" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/messageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_ai"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:id="@+id/messageAttachmentList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/finalReplyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false"
                android:text="最终回复"
                android:textColor="@color/elon_accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/elon_text_primary"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/evidenceSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_process_summary"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/evidenceDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="1dp"
            android:maxWidth="260dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/evidenceLastEntry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1dp"
            android:maxWidth="260dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/modelAttributionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#5A5A5A"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/apkActionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/apkInstallBtn"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="安装"
                android:textColor="@color/elon_button_primary_bg"
                android:textSize="13sp" />

            <Button
                android:id="@+id/apkCopyBtn"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="复制链接"
                android:textColor="@color/elon_link_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/apkShareBtn"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="分享"
                android:textColor="@color/elon_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
