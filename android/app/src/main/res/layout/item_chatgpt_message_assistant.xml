<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="7dp"
    android:paddingEnd="44dp"
    android:paddingBottom="7dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_app_brand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatGptMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_ai"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="10dp"
            android:textColor="@color/elon_text_primary"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/chatGptMessageParts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatGptMessageState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/elon_text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/chatGptMessageCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/chatgpt_message_copy"
                android:padding="12dp"
                android:src="@drawable/ic_msg_copy"
                android:tooltipText="@string/chatgpt_message_copy" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/chatGptMessageRegenerate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/chatgpt_message_regenerate"
                android:padding="12dp"
                android:src="@drawable/ic_side_menu_refresh"
                android:tooltipText="@string/chatgpt_message_regenerate"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/chatGptMessageMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/chatgpt_message_more_actions"
                android:padding="12dp"
                android:src="@drawable/ic_more_horizontal"
                android:tooltipText="@string/chatgpt_message_more_actions"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
