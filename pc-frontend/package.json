{
  "name": "elon-pc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:message-flow": "node ../scripts/test-pc-frontend-message-flow.js && node ../scripts/test-pc-frontend-task-result-tone.js && node ../scripts/test-pc-frontend-task-timeline-display.js && node ../scripts/test-pc-frontend-task-progress-preview.js && node ../scripts/test-pc-frontend-task-replay.js && node ../scripts/test-pc-frontend-task-recovery-snapshot.js",
    "test:workspace-access": "node ../scripts/test-pc-frontend-workspace-access.js && node ../scripts/test-pc-frontend-full-access-auto-grant.js",
    "test:local-tasks": "node scripts/test-local-tasks.cjs && node scripts/test-progressive-lists.cjs",
    "test:runtime-draft": "node scripts/test-runtime-draft-model.cjs",
    "test:ui-tuner-workspace": "node scripts/test-ui-tuner-workspace.cjs",
    "test:pwa-design": "node scripts/test-pwa-design.cjs && node scripts/test-pwa-runtime-capture.cjs && node scripts/test-fit-run-events.cjs && node ../scripts/test-pwa-ui-tuner-bridge.js",
    "test:project-docs": "node scripts/test-project-document-sections.cjs && node scripts/test-project-document-discussions.cjs",
    "test:project-home": "node ../scripts/test-pc-project-home.js && node ../scripts/test-pc-project-context-sidebar.js",
    "test:plaza": "node scripts/test-project-plaza-carousel.mjs",
    "test:message-actions": "node scripts/test-message-actions-hover.cjs",
    "check:bundle-budget": "node ../scripts/check-pc-frontend-bundle-budget.js",
    "test:admin-realtime": "node ../scripts/test-admin-realtime-health.js",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.1",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5.5.3",
    "vite": "^8.1.5"
  }
}
