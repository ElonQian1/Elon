{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yilong.example/contracts/erp/erp-materialization-evidence-v1.schema.json",
  "title": "ERP instance materialization evidence V1",
  "type": "object",
  "required": ["schema", "instance_id", "configuration_revision", "source_git_commit", "instance_manifest_path", "instance_manifest_sha256", "verification_passed"],
  "properties": {
    "schema": { "const": "yilong.erp.materialization_evidence.v1" },
    "instance_id": { "type": "string", "minLength": 1 },
    "configuration_revision": { "type": "integer", "minimum": 1 },
    "source_git_commit": { "type": "string", "pattern": "^[0-9A-Fa-f]{7,64}$" },
    "instance_manifest_path": { "const": ".yilong/erp-instance.json" },
    "instance_manifest_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "verification_passed": { "const": true }
  },
  "additionalProperties": true
}
