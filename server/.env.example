# 服务端环境变量配置
# 复制此文件为 .env 并填入真实值（.env 不提交到 git）

# ===================
# AI 代理配置（至少配置一个）
# ===================

# OpenAI
# AGENT_OPENAI_KEY=sk-你的OpenAI密钥
# AGENT_OPENAI_BASE=https://api.openai.com/v1
# AGENT_OPENAI_MODEL=gpt-4o

# DeepSeek（国内首选，价格便宜）
AGENT_DEEPSEEK_KEY=sk-你的DeepSeek密钥
# AGENT_DEEPSEEK_BASE=https://api.deepseek.com/v1
# AGENT_DEEPSEEK_MODEL=deepseek-chat

# Claude
# AGENT_CLAUDE_KEY=sk-ant-你的Claude密钥
# AGENT_CLAUDE_BASE=https://api.anthropic.com/v1
# AGENT_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 自定义兼容 OpenAI 接口
# AGENT_CUSTOM_KEY=密钥
# AGENT_CUSTOM_BASE=https://自定义接口地址/v1
# AGENT_CUSTOM_MODEL=模型名

# 默认使用的 AI 代理（不填则自动用第一个配置的）
# DEFAULT_AGENT=deepseek

# ===================
# 服务配置
# ===================

# 用户工作区根目录
# 每个用户有独立子目录：{WORKSPACE_ROOT}/{user_id}/
WORKSPACE_ROOT=/home/ubuntu/workspaces

# 服务监听地址
LISTEN_ADDR=0.0.0.0:8080

# 日志级别
RUST_LOG=info,elon_server=debug

AI_API_KEY=sk-你的API密钥填这里

# AI API 地址（默认 OpenAI，可替换为其他兼容接口）
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 中转代理: https://你的代理地址/v1
AI_API_BASE=https://api.openai.com/v1

# 使用的模型（推荐 gpt-4o 或 deepseek-chat）
AI_MODEL=gpt-4o

# 项目代码根目录（AI 代理在此目录内读写文件）
PROJECT_ROOT=/home/ubuntu/Elon

# 服务监听地址（0.0.0.0 表示外网可访问）
LISTEN_ADDR=0.0.0.0:8080

# 日志级别
RUST_LOG=info,elon_server=debug
