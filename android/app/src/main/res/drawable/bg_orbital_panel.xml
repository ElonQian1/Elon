<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/elon_surface_header"
                android:centerColor="@color/elon_surface_card"
                android:endColor="@color/elon_bg_chrome" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/elon_border_subtle" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@android:color/transparent"
                android:centerColor="@color/elon_metal_highlight"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
