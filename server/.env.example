# 服务端环境变量配置
# 复制此文件为 .env 并填入真实值（.env 不提交到 git）

# AI API Key（必填）
# 支持 OpenAI、Claude (via 兼容代理)、DeepSeek 等兼容 OpenAI 接口的服务
AI_API_KEY=sk-你的API密钥填这里

# AI API 地址（默认 OpenAI，可替换为其他兼容接口）
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 中转代理: https://你的代理地址/v1
AI_API_BASE=https://api.openai.com/v1

# 使用的模型（推荐 gpt-4o 或 deepseek-chat）
AI_MODEL=gpt-4o

# 项目代码根目录（AI 代理在此目录内读写文件）
PROJECT_ROOT=/home/ubuntu/Elon

# 服务监听地址（0.0.0.0 表示外网可访问）
LISTEN_ADDR=0.0.0.0:8080

# 日志级别
RUST_LOG=info,elon_server=debug
