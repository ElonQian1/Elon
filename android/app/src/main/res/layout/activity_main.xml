<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/elon_bg_app"
        android:contentInsetStart="0dp"
        android:contentInsetEnd="0dp"
        android:elevation="0dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/elon_text_primary"
                android:textSize="27sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/topTitleText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="会话区"
                android:textColor="@color/elon_text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/projectTopTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="84dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/projectHomeTopTabWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="52dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projectHomeTopTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="我的项目"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="20dp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/projectHomeTabIndicator"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="5dp"
                        android:background="@color/elon_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/projectPlazaTopTabWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projectPlazaTopTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="项目广场"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="20dp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/projectPlazaTabIndicator"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/elon_text_primary"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="92dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="搜索"
                android:padding="7dp"
                android:src="@drawable/ic_search_simple"
                app:tint="@color/elon_text_secondary" />

            <ImageButton
                android:id="@+id/addButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_top_add_button"
                android:contentDescription="新增"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_project_fab_plus"
                app:tint="@color/elon_icon_add_top" />

            <ImageButton
                android:id="@+id/projectMembersButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="成员列表"
                android:padding="7dp"
                android:src="@drawable/ic_project_members"
                android:visibility="gone"
                app:tint="@color/elon_text_secondary" />

            <ImageButton
                android:id="@+id/voiceCallButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="92dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="实时语音通话"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_top_phone"
                android:visibility="gone"
                app:tint="@color/elon_text_primary" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多功能"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_more_horizontal"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/elon_bg_app">

        <LinearLayout
            android:id="@+id/conversationPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/conversationItem"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@color/elon_surface_card"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_app_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projectStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="一龙开发助手"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="连接中..."
                        android:textColor="@color/elon_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/conversationTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"
                    android:text="时间"
                    android:textColor="@color/elon_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/quickActionStrip"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@color/elon_bg_app"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/quickPlanButton"
                        style="@style/QuickActionButton"
                        android:text="需求规划" />

                    <TextView
                        android:id="@+id/quickContinueButton"
                        style="@style/QuickActionButton"
                        android:text="继续开发" />

                    <TextView
                        android:id="@+id/quickBuildButton"
                        style="@style/QuickActionButton"
                        android:text="打包 APK" />

                    <TextView
                        android:id="@+id/quickHistoryButton"
                        style="@style/QuickActionButton"
                        android:text="项目记录" />

                    <TextView
                        android:id="@+id/quickSettingsButton"
                        style="@style/QuickActionButton"
                        android:text="AI 设置" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/stageHintText"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@color/elon_surface_subtle"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="点击输入需求，开发进度会自动记录到项目页。"
                android:textColor="@color/elon_text_secondary"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/projectPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/projectScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/elon_bg_app"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/projectContentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/currentStageText"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@color/elon_surface_card"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="待提交需求"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/projectOverviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:background="@color/elon_surface_card"
                        android:lineSpacingExtra="5dp"
                        android:minHeight="104dp"
                        android:padding="22dp"
                        android:text="项目管理\n当前没有正在执行的开发任务。"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/elon_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/progressTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="开发进度"
                            android:textColor="@color/elon_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/stagePlanText"
                            style="@style/StageLineText"
                            android:text="1. 需求分析：等待" />

                        <TextView
                            android:id="@+id/stageCodeText"
                            style="@style/StageLineText"
                            android:text="2. 开发实现：等待" />

                        <TextView
                            android:id="@+id/stageBuildText"
                            style="@style/StageLineText"
                            android:text="3. 编译打包：等待" />

                        <TextView
                            android:id="@+id/stageDeliverText"
                            style="@style/StageLineText"
                            android:text="4. 交付下载：等待" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/projectWorkflowText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/elon_surface_card"
                        android:lineSpacingExtra="4dp"
                        android:minHeight="112dp"
                        android:padding="18dp"
                        android:text="通用项目工作流\n1. 准备 Git 和权限\n2. 读取项目文档\n3. 修改和验证\n4. 提交推送\n5. 合并发布串行保护"
                        android:textColor="@color/elon_text_secondary"
                        android:textSize="13sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/elon_surface_card"
                        android:columnCount="2"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/projectContinueButton"
                            style="@style/ProjectActionButton"
                            android:text="继续开发" />

                        <TextView
                            android:id="@+id/projectBuildButton"
                            style="@style/ProjectActionButton"
                            android:text="生成 APK" />

                        <TextView
                            android:id="@+id/projectRecordButton"
                            style="@style/ProjectActionButton"
                            android:text="进度记录" />

                        <TextView
                            android:id="@+id/projectGitButton"
                            style="@style/ProjectActionButton"
                            android:text="Git 仓库" />

                        <TextView
                            android:id="@+id/projectSettingsButton"
                            style="@style/ProjectActionButton"
                            android:text="模型设置" />
                    </GridLayout>

                    <TextView
                        android:id="@+id/projectHistoryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/elon_surface_card"
                        android:lineSpacingExtra="5dp"
                        android:minHeight="220dp"
                        android:padding="22dp"
                        android:text="暂无进度记录"
                        android:textColor="@color/elon_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/projectSpaceFeedActionsOverlay"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="96dp"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageButton
                android:visibility="gone"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_project_space_fab"
                android:contentDescription="项目文档"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="18dp"
                android:scaleType="fitCenter"
                app:tint="@color/elon_text_primary" />

            <ImageButton
                android:id="@+id/projectSpacePostFab"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_project_space_fab"
                android:contentDescription="发布帖子"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="14dp"
                android:scaleType="center"
                android:src="@drawable/ic_project_fab_plus"
                app:tint="@color/elon_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/projectSpaceAiMenu"
            android:layout_width="176dp"
            android:layout_height="64dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_project_space_ai_menu_item"
            android:clickable="true"
            android:clipToOutline="true"
            android:contentDescription="打开项目 AI 会话"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/projectSpaceAiIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_project_ai_conversation"
                app:tint="@color/elon_text_primary" />

            <com.elon.app.ProjectSpaceAiLabelView
                android:id="@+id/projectSpaceAiLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Ai 会话"
                android:textColor="@color/elon_text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/profilePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/elon_surface_card"
                    android:lineSpacingExtra="5dp"
                    android:minHeight="112dp"
                    android:padding="22dp"
                    android:text="我的开发工作台"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/profileUsageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/profileNodeBalanceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/profileNodeDirectoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/profileMyNodesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/profileMemoriesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/profileLoginButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="登录账号 · 多设备同步"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profileSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="AI 代理设置"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileAgentButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Agent 自动化"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileNodeMarketButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="PC 节点大厅"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileCheckUpdateButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="检查更新"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileShareButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="分享推广"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileImportGuestButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="导入游客记录"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profileLogoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/elon_surface_card"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="退出登录"
                    android:textColor="#FF7A7A"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profileVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:paddingBottom="24dp"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/marketplacePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/marketplaceListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </ScrollView>

        <include
            android:id="@+id/agentPage"
            layout="@layout/page_agent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chatSelectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_chat_selection_bar"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectionCountText"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="选择消息"
                android:textColor="@color/elon_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectionCancelButton"
                    style="@style/ChatSelectionActionText"
                    android:drawableTop="@drawable/ic_msg_multi"
                    android:drawableTint="@color/elon_text_primary"
                    android:text="取消" />

                <TextView
                    android:id="@+id/selectionCopyButton"
                    style="@style/ChatSelectionActionText"
                    android:drawableTop="@drawable/ic_msg_copy"
                    android:drawableTint="@color/elon_text_primary"
                    android:text="复制" />

                <TextView
                    android:id="@+id/selectionForwardButton"
                    style="@style/ChatSelectionActionText"
                    android:drawableTop="@drawable/ic_msg_forward"
                    android:drawableTint="@color/elon_text_primary"
                    android:text="转发" />

                <TextView
                    android:id="@+id/selectionSummarizeButton"
                    style="@style/ChatSelectionActionText"
                    android:drawableTop="@drawable/ic_popup_chat"
                    android:drawableTint="@color/elon_text_primary"
                    android:text="AI总结" />

                <TextView
                    android:id="@+id/selectionDeleteButton"
                    style="@style/ChatSelectionActionText"
                    android:drawableTop="@drawable/ic_msg_delete"
                    android:drawableTint="#F06E6E"
                    android:text="删除"
                    android:textColor="#F06E6E" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/elon_nav_bg"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/inputEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="描述你想开发的 App 功能"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="42dp"
                android:minLines="1"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/elon_text_primary"
                android:textColorHint="@color/elon_text_tertiary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/modelButton"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_button"
                android:gravity="center"
                android:maxLines="1"
                android:text="默认"
                android:textColor="@color/elon_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sendButton"
                android:layout_width="64dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:gravity="center"
                android:text="发送"
                android:textColor="@color/elon_button_primary_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_bottom_menu_height"
            android:layout_gravity="bottom"
            android:background="@color/elon_nav_bg"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/tabChatWrap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tabChat"
                    style="@style/MainTabText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:drawableTop="@drawable/ic_tab_chat_refined"
                    android:text="好友" />

                <TextView
                    android:id="@+id/tabChatBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="17dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/tabProject"
                style="@style/MainTabText"
                android:drawableTop="@drawable/ic_tab_project_refined"
                android:text="项目" />

            <TextView
                android:id="@+id/tabProfile"
                style="@style/MainTabText"
                android:drawableTop="@drawable/ic_tab_profile_user"
                android:text="我的" />

            <TextView
                android:id="@+id/tabMarket"
                style="@style/MainTabText"
                android:drawableTop="@drawable/ic_tab_store"
                android:text="商城"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabAgent"
                style="@style/MainTabText"
                android:drawableTop="@drawable/ic_tab_agent"
                android:text="Agent"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
