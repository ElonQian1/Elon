<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="80dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一龙"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="云端 APK 开发平台"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@color/elon_surface_card"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/loginTabLogin"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/elon_button_secondary_bg"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/elon_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/loginTabRegister"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/elon_surface_card"
                android:gravity="center"
                android:text="注册"
                android:textColor="@color/elon_text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="账号"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/loginAccountInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:autofillHints="username"
            android:background="@drawable/bg_input"
            android:hint="手机号、邮箱或账号 ID"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/loginNicknameRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="昵称"
                android:textColor="@color/elon_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/loginNicknameInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:autofillHints="nickname"
                android:background="@drawable/bg_input"
                android:hint="工作台展示名"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/elon_text_primary"
                android:textColorHint="@color/elon_text_tertiary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="密码"
            android:textColor="@color/elon_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/loginPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input"
            android:hint="至少 6 位"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/elon_text_primary"
            android:textColorHint="@color/elon_text_tertiary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/loginErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loginSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_send_button"
            android:gravity="center"
            android:text="登录"
            android:textColor="@color/elon_button_primary_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/loginSkipButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="稍后再说 · 以游客方式继续"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="登录后可在网页版和其它手机间同步项目"
            android:textColor="@color/elon_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
