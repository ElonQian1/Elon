<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/elon_bg_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/chatGptWebBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatgpt_web_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_toolbar_back_custom"
            android:tooltipText="@string/chatgpt_web_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/chatgpt_web_title"
                android:textColor="@color/elon_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chatGptWebHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/chatgpt_web_host"
                android:textColor="@color/elon_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/chatGptWebProxy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatgpt_web_proxy_title"
            android:padding="13dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tooltipText="@string/chatgpt_web_proxy_title"
            app:tint="@color/elon_icon_primary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/chatGptWebReload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatgpt_web_reload"
            android:padding="13dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tooltipText="@string/chatgpt_web_reload"
            app:tint="@color/elon_icon_primary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/chatGptWebClearSession"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatgpt_web_clear"
            android:padding="13dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tooltipText="@string/chatgpt_web_clear"
            app:tint="@color/elon_status_danger" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/chatGptWebProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/elon_status_info" />

    <TextView
        android:id="@+id/chatGptWebStatus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@color/elon_surface_header"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:text="@string/chatgpt_web_preparing"
        android:textColor="@color/elon_text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/chatGptModeToggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/elon_bg_chrome"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        app:checkedButton="@id/chatGptModeQuick"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatGptModeQuick"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/chatgpt_mode_quick"
            android:textAllCaps="false"
            android:textColor="@color/elon_text_primary"
            android:textSize="12sp"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/elon_border_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatGptModeWeb"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/chatgpt_mode_web"
            android:textAllCaps="false"
            android:textColor="@color/elon_text_primary"
            android:textSize="12sp"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/elon_border_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatGptModeNative"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/chatgpt_mode_native"
            android:textAllCaps="false"
            android:textColor="@color/elon_text_primary"
            android:textSize="12sp"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/elon_border_primary" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/chatGptWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:importantForAutofill="yes" />

        <ScrollView
            android:id="@+id/chatGptQuickRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="52dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_popup_chat"
                    app:tint="@color/elon_titanium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/chatgpt_quick_eyebrow"
                    android:textColor="@color/elon_text_accent"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/chatgpt_quick_title"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxWidth="340dp"
                    android:text="@string/chatgpt_quick_summary"
                    android:textColor="@color/elon_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/chatGptQuickWebAuthentication"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/chatgpt_web_authentication_unavailable"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chatGptQuickStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/chatgpt_quick_stage_ready"
                    android:textColor="@color/elon_status_success"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/chatGptQuickElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/chatgpt_quick_elapsed"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="12sp"
                    android:visibility="invisible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatGptQuickGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:maxWidth="360dp"
                    android:text="@string/chatgpt_google_account_login"
                    android:textAllCaps="false"
                    android:textColor="@color/elon_titanium_ink"
                    android:textSize="17sp"
                    app:backgroundTint="@color/elon_titanium"
                    app:cornerRadius="6dp"
                    app:rippleColor="@android:color/transparent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatGptQuickLogin"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:maxWidth="360dp"
                    android:text="@string/chatgpt_quick_login"
                    android:textAllCaps="false"
                    android:textColor="@color/elon_text_primary"
                    app:cornerRadius="6dp"
                    app:rippleColor="@android:color/transparent"
                    app:strokeColor="@color/elon_border_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatGptQuickOfficial"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:maxWidth="360dp"
                    android:text="@string/chatgpt_quick_official"
                    android:textAllCaps="false"
                    android:textColor="@color/elon_text_primary"
                    app:cornerRadius="6dp"
                    app:rippleColor="@android:color/transparent"
                    app:strokeColor="@color/elon_border_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/chatgpt_quick_privacy"
                    android:textColor="@color/elon_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/chatGptNativeRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/elon_bg_app"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/elon_surface_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/chatGptNativeHistory"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/chatgpt_native_history"
                    android:padding="9dp"
                    android:src="@drawable/ic_popup_history"
                    android:tooltipText="@string/chatgpt_native_history" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="ChatGPT"
                    android:textColor="@color/elon_text_primary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/chatGptNativeNew"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/chatgpt_native_new"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_input_add"
                    android:tooltipText="@string/chatgpt_native_new"
                    app:tint="@color/elon_icon_primary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/chatGptNativeStop"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/chatgpt_native_stop"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:tooltipText="@string/chatgpt_native_stop"
                    app:tint="@color/elon_status_project" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chatGptNativeMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp" />

                <TextView
                    android:id="@+id/chatGptNativeEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/chatgpt_native_connecting"
                    android:textColor="@color/elon_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/elon_input_panel_bg_70"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/chatGptNativeModel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_model_pill_light"
                        android:drawableEnd="@drawable/ic_input_model_chevron"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chatgpt_native_model_default"
                        android:textAllCaps="false"
                        android:textColor="@color/elon_text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/chatGptNativeAttachment"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/chatgpt_native_attachment"
                        android:padding="7dp"
                        android:src="@drawable/ic_attach_files"
                        android:tooltipText="@string/chatgpt_native_attachment" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/chatGptNativeTools"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/chatgpt_native_tools_title"
                        android:padding="7dp"
                        android:src="@drawable/ic_attach_function"
                        android:tooltipText="@string/chatgpt_native_tools_title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/chatGptNativeComposer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/chatgpt_native_input_hint"
                        android:imeOptions="actionSend"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minHeight="44dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp"
                        android:textColor="@color/elon_text_primary"
                        android:textColorHint="@color/elon_text_tertiary"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/chatGptNativeSend"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/chatgpt_native_send"
                        android:padding="4dp"
                        android:src="@drawable/ic_input_send_arrow_circle"
                        android:tooltipText="@string/chatgpt_native_send" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
