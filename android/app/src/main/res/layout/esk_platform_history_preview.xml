<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/esk_platform_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
    <TextView
        android:id="@+id/esk_platform_history_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESK 正式审核流水"
        android:textColor="@color/elon_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="正式平台登记 · 尚未上链"
        android:textColor="@color/elon_status_project" android:textSize="13sp" />
    <TextView android:id="@+id/esk_history_account"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="当前账户"
        android:textColor="@color/elon_text_secondary" android:textSize="15sp" />
    <TextView android:id="@+id/esk_history_total"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="— ESK" android:textStyle="bold"
        android:textColor="@color/elon_text_primary" android:textSize="24sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="全账户审核总额，不是当前页小计；不包含 Paper 模拟资产。"
        android:textColor="@color/elon_text_secondary" android:textSize="13sp" />
    <TextView android:id="@+id/esk_history_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite"
        android:text="重新加载后查看本人的全部审核流水，每次显示一页。"
        android:textColor="@color/elon_text_secondary" android:textSize="15sp" />
    <Button
        android:id="@+id/esk_platform_history_primary_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="16dp"
        android:text="重新加载 · 第一页" android:textSize="16sp" />
    <LinearLayout android:id="@+id/esk_history_entries"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <Button android:id="@+id/esk_history_next"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:minHeight="52dp" android:visibility="gone"
        android:text="下一页" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:lineSpacingExtra="4dp"
        android:text="仅供本人查账。正式登记由管理员审核，不代表系统自动验证付款，也不代表已上链、可提现或已产生收益。账本更新、换号或离开本页后需重新加载。"
        android:textColor="@color/elon_text_secondary" android:textSize="13sp" />
    <Button android:id="@+id/esk_history_back"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:minHeight="52dp"
        android:text="返回正式资产" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
