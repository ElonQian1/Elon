<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_provider_accounts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elon_bg_app"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择 OpenAI 聊天方式"
        android:textColor="@color/elon_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ChatKit 使用一龙账号和平台 OpenAI API，不需要登录 ChatGPT，也不读取 ChatGPT Cookie、历史或 Plus 额度。"
        android:textColor="@color/elon_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="OpenAI API Key 只保存在服务端，APK 只接收短时 ChatKit 会话。"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/aiProviderOpenAiChatKit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/elon_button_primary_bg"
        android:drawableStart="@android:drawable/ic_dialog_email"
        android:drawableTint="@color/elon_button_primary_text"
        android:text="打开 OpenAI ChatKit"
        android:textColor="@color/elon_button_primary_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="ChatGPT 官方网页账号"
        android:textColor="@color/elon_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1  打开 ChatGPT 官方页面\n2  本人完成登录和真人验证\n3  在官方网页或一龙增强界面聊天\nCookie 和网页数据只保存在本 APK。"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/aiProviderChatGptWebLab"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/elon_button_secondary_bg"
        android:drawableStart="@android:drawable/ic_menu_view"
        android:drawableTint="@color/elon_button_secondary_text"
        android:text="@string/chatgpt_web_lab_entry"
        android:textColor="@color/elon_button_secondary_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="高级功能 · Win 节点 CLI 账号"
        android:textColor="@color/elon_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="管理 Codex、Gemini、Claude 或 Copilot 官方 CLI 登录；与上面的 ChatGPT 网页会话相互独立。"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_orbital_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Spinner
            android:id="@+id/aiProviderNodeSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:popupBackground="@color/elon_surface_header"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/aiProviderRefresh"
            android:layout_width="88dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/elon_button_secondary_bg"
            android:text="刷新节点"
            android:textColor="@color/elon_button_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/aiProviderProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aiProviderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="正在读取节点…"
        android:textColor="@color/elon_text_tertiary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/aiProviderDiagnostics"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/elon_button_secondary_bg"
        android:text="读取脱敏恢复诊断"
        android:textColor="@color/elon_button_secondary_text"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/aiProviderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />
    </ScrollView>

</LinearLayout>
