# Local machine overrides. Copy values into .env.local; do not commit .env.local.
#
# Optional repository root for wrappers or agents that start outside the Git workspace.
# Prefer setting ELON_REPO_PATH as an OS environment variable when possible.
#
# Windows example:
# ELON_REPO_PATH=D:\path\to\Elon
#
# Linux/macOS example:
# ELON_REPO_PATH=/home/me/Elon
#
# Windows example:
# ELON_BUILD_TARGET_DIR=D:\rust\shared\target
#
# Machine-wide Rust server musl cache shared across backend repos:
# RUST_SERVER_MUSL_TARGET_DIR=D:\rust\shared\server-musl-target
#
# Daily Rust validation cache for cargo check/test/build/clippy wrappers.
# Use a different directory from RUST_SERVER_MUSL_TARGET_DIR because release
# musl artifacts and local dev artifacts have different target triples/profiles.
# Windows example:
# ELON_DEV_CARGO_TARGET_DIR=D:\rust\shared\elon-dev-cargo-target
#
# Windows PC node publish cache (kept separate from dev and server-musl):
# ELON_NODE_AGENT_TARGET_DIR=D:\rust\shared\elon-node-agent-target
#
# Linux/macOS example:
# ELON_DEV_CARGO_TARGET_DIR=/var/tmp/elon-dev-cargo-target
#
# Linux/macOS example:
# ELON_BUILD_TARGET_DIR=/var/tmp/elon-build-target
