<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ElonApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/elon_bg_app</item>
        <item name="colorPrimaryVariant">@color/elon_bg_app</item>
        <item name="colorOnPrimary">@color/elon_text_primary</item>
        <item name="android:statusBarColor">@color/elon_bg_app</item>
        <item name="android:navigationBarColor">@color/elon_nav_bg</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="MainTabText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/elon_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="QuickActionButton">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_quick_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/elon_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="StageLineText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/elon_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProjectActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_dark_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/elon_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Agent 透明主题（悬浮球弹出 Activity 用） -->
    <style name="Theme.Transparent.AppCompat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="ChatSelectionActionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/elon_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>
